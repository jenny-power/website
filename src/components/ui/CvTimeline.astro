---
import { isExperience, isEducation, isTeaching, isVolunteering } from '@/types/cv';
import type { Experience, Education, Teaching, Volunteering } from '@/types/cv';

interface Props {
  elements: (Experience | Education | Teaching | Volunteering)[];
  colored: boolean;
}

const { elements, colored } = Astro.props;
---

<ul class="timeline timeline-snap-icon timeline-compact timeline-vertical">
  {elements.map((element) => (
    <li>
      <!-- Timeline marker -->
      <div class="timeline-middle">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class:list={[{ 'text-accent': colored }, 'h-5 w-5']}
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
            clip-rule="evenodd"
          />
        </svg>
      </div>

      <div class="timeline-start mb-10 pl-6">
        <!-- Title / Degree -->
        <div class="text-lg font-black">
          {isExperience(element)
            ? element.title
            : isEducation(element)
            ? element.degree
            : isTeaching(element)
            ? element.title
            : isVolunteering(element)
            ? element.title
            : ''}
        </div>

        <!-- Time -->
        <div class="flex items-center gap-2 text-sm opacity-80">
          <i class="fa-solid fa-calendar text-info opacity-90"></i>
          <time>{element.time}</time>
        </div>

        <!-- Company / School / Location -->
        {!isVolunteering(element) && (
          <div class="flex items-center gap-2 text-sm opacity-70 mt-2">
            <i class="fa-solid fa-location-dot text-info opacity-90"></i>
            <span>
              {isExperience(element)
                ? element.company
                : isEducation(element)
                ? element.school
                : isTeaching(element)
                ? element.company
                : ''}
              , {element.location}
            </span>
          </div>
        )}

        <!-- Description -->
        {element.description && (
          <div
			class="description mt-3 text-[0.95rem] leading-[1.35] text-base-content dark:text-base-content/90 space-y-2 
			[&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 
			[&_a]:text-accent [&_a]:px-1 [&_a]:rounded-md 
			[&_a:hover]:bg-accent/20 [&_a:hover]:text-accent"
			set:html={element.description}
          ></div>
        )}
      </div>

      <hr class:list={[{ 'bg-accent': colored }]} />
    </li>
  ))}
</ul>
